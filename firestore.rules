rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test connection doc
    match /test/{testId} {
      allow read, write: if true;
    }

    // Classroom Group Progress real-time sync
    match /groups/{groupId} {
      allow read: if true;
      allow write: if request.resource.data.groupName is string
                   && request.resource.data.score is number
                   && request.resource.data.mission1Cleared is bool
                   && request.resource.data.mission2Cleared is bool
                   && request.resource.data.mission3Cleared is bool
                   && request.resource.data.lastUpdated is number;
    }
  }
}
